# Copy this file to .env.local and fill in your own Supabase project's values.
# .env.local is gitignored — never commit real credentials.
#
# Both variables below are safe to expose in the browser (that's what
# NEXT_PUBLIC_ means) — they identify your project and use Supabase's public
# "anon" key, which relies on Row Level Security (see
# supabase/migrations/0001_init.sql) to keep user data private. Never put a
# service-role key or database password in this file or anywhere in the
# frontend — see docs/SUPABASE-SETUP.md.
#
# If these are left blank (or this file isn't copied to .env.local at all),
# the app runs in Local Demo Mode: no accounts, no cloud sync, everything
# saved to this browser's storage only — see root CLAUDE.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 6 — AI Tutor. SERVER-SIDE ONLY: never prefix this with NEXT_PUBLIC_,
# never read it from client code, never commit a real value. Without it, the
# app still runs fully — the /tutor page just shows "AI Tutor is not
# configured in this environment" and every other page is unaffected. This is
# a separate credential from a Claude Code / Claude.ai subscription — it's an
# Anthropic API key, created at https://console.anthropic.com.
# See dhl-training-hub/docs/AI-TUTOR.md for full setup steps.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset — a deliberate modest-cost,
# fast choice for conversational tutoring (see docs/AI-TUTOR.md), not the
# most expensive model available.
ANTHROPIC_MODEL=
